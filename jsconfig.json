{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"],
            "ziggy-js": ["vendor/tightenco/ziggy"]
        },
        "jsx": "preserve"
    },
    "include": [
        "resources/js/**/*",
        "resources/js/**/*.vue"
    ],
    "exclude": [
        "node_modules",
        "public",
        "storage",
        "vendor"
    ]
}
